{
  "expo": {
    "name": "overlaykit",
    "slug": "overlaykit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "overlaykit",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.overlaykit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14304F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.overlaykit.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OverlayKit uses the camera to read text on signs and machines.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "OverlayKit uses the microphone only when you tap the voice button, to hear the goal you say.",
          "speechRecognitionPermission": "OverlayKit uses speech recognition to turn the goal you say into text."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
